local flyButton = createButton("Fly: OFF", 144)

flyButton.MouseButton1Click:Connect(function()
	if flyEnabled then

		flyEnabled = false

		if bodyVelocity then
			bodyVelocity:Destroy()
			bodyVelocity = nil
		end

		if bodyGyro then
			bodyGyro:Destroy()
			bodyGyro = nil
		end

		if humanoid then
			humanoid.PlatformStand = false
		end

