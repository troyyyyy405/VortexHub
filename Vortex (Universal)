	else

		if root and humanoid then
			flyEnabled = true

			bodyVelocity = Instance.new("BodyVelocity")
			bodyVelocity.Name = "VortexFlyVelocity"
			bodyVelocity.MaxForce = Vector3.new(
				math.huge,
				math.huge,
