--==================================================
-- DRAGGABLE LOGO
--==================================================

local logoDragging = false
local logoDragStart
local logoStartPosition

logo.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		logoDragging = true
		logoDragStart = input.Position
		logoStartPosition = logo.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				logoDragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if logoDragging then
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta = input.Position - logoDragStart

			logo.Position = UDim2.new(
				logoStartPosition.X.Scale,
				logoStartPosition.X.Offset + delta.X,
				logoStartPosition.Y.Scale,
				logoStartPosition.Y.Offset + delta.Y
			)
		end
	end
end)

--==================================================
-- LOGO TOGGLE
--==================================================

local logoPressStart = 0

logo.MouseButton1Down:Connect(function()
	logoPressStart = os.clock()
end)

logo.MouseButton1Click:Connect(function()
	if os.clock() - logoPressStart < 0.25 then
		main.Visible = not main.Visible
	end
end)

--==================================================
-- MOVEMENT LOOP
--==================================================

RunService.RenderStepped:Connect(function()
	if not character or not humanoid or not root then
		return
	end

	-- NO CLIP
	if noclipEnabled then
		for _, object in ipairs(character:GetDescendants()) do
			if object:IsA("BasePart") then
				object.CanCollide = false
			end
		end
	end

	-- FLY
	if flyEnabled and bodyVelocity and bodyGyro then
		local camera = workspace.CurrentCamera

		-- Humanoid.MoveDirection follows the Roblox
		-- mobile joystick / keyboard movement.

		local moveDirection = humanoid.MoveDirection

		if moveDirection.Magnitude > 0 then
			bodyVelocity.Velocity =
				moveDirection.Unit * flySpeed
		else
			bodyVelocity.Velocity = Vector3.zero
		end

		-- Face the direction the camera is looking.
		bodyGyro.CFrame = CFrame.lookAt(
			root.Position,
			root.Position + camera.CFrame.LookVector
		)
	end
end)
